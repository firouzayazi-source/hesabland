cmd_backup() {
    local offsite=0
    for a in "$@"; do [[ "$a" == "--offsite" ]] && offsite=1; done

    step "بکاپِ دیتابیس"
    if [[ ! -x deploy/backup.sh ]]; then
        red "deploy/backup.sh پیدا نشد."
        return 1
    fi
    bash deploy/backup.sh 2>&1 | sed 's/^/  /'

    if (( offsite )); then
        step "فرستادنِ بکاپ به بیرونِ سرور"
        if [[ -x deploy/backup-offsite.sh ]]; then
            bash deploy/backup-offsite.sh --send 2>&1 | sed 's/^/  /' || \
                warn "⚠ ارسالِ بیرونی انجام نشد — deploy/backup-offsite.sh --check را ببینید."
        else
            warn "⚠ deploy/backup-offsite.sh نیست."
        fi
    fi
}

# ---------------------------------------------------------------------
cmd_logs() {
    step "خلاصه‌ی ۲۴ ساعتِ گذشته (var/log)"
    # ⚠ کدِ خروجِ ناصفر یعنی آستانه‌ای رد شده — اینجا فقط نشان داده
    #   می‌شود؛ `logs` نباید به‌خاطرِ یک هشدار بمیرد.
    php deploy/log-report.php --hours 24 2>/dev/null | sed 's/^/  /' || true
    step "آخرین خطوطِ warn/error"
    php deploy/log-report.php --hours 24 --tail 15 2>/dev/null | sed 's/^/  /' || true
    info "  یک درخواستِ خاص:  php deploy/log-report.php --req کدِپیگیری"

    step "آخرین خطاهای ثبت‌شده‌ی اپ"
    # ⚠ `require_once` اجباری است، نه سلیقه: خودِ `db.php` فایلِ
    #   `app_errors.php` را لود می‌کند، پس `require`ِ ساده کلاس را دوباره
    #   تعریف می‌کند و خطای کشنده می‌دهد.
    php -r '
        require_once "includes/db.php";
        require_once "includes/app_errors.php";
        $rows = AppErrors::recent(15);
        if (!$rows) { echo "  هیچ خطایی ثبت نشده.\n"; exit; }
        foreach ($rows as $r) {
            printf("  [%s] %s  (%d بار، آخرین: %s)\n",
                $r["level"] ?? "?", mb_substr($r["message"] ?? "", 0, 110),
                (int)($r["hits"] ?? 1), $r["last_seen"] ?? "?");
        }
    ' 2>/dev/null || warn "⚠ خواندنِ خطاها ممکن نشد (دیتابیس یا جدولِ app_errors)."
}

# ---------------------------------------------------------------------
cmd_status() {
    bold "══ وضعیتِ حساب لند ══"

    step "نسخه"
    info "  کامیت:  $(git rev-parse --short HEAD 2>/dev/null || echo '?')  ($(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?'))"
    info "  پیام:   $(git log -1 --pretty=%s 2>/dev/null || echo '?')"
    info "  تاریخ:  $(git log -1 --pretty=%cd --date=short 2>/dev/null || echo '?')"
    info "  var/version.txt: $(cat var/version.txt 2>/dev/null || echo '—')"
    info "  دارایی‌ها: $(asset_version)"

    # ⛔ «آخرین استقرارِ موفق» — نه آخرین اجرا، نه آخرین کامیت. تفاوتشان
    #    همان چیزی است که امروز نیم ساعت طول کشید تا دیده شود.
    if [[ -r "$DEPLOY_BEAT" ]]; then
        local beat_at beat_ref beat_age
        read -r beat_at beat_ref < "$DEPLOY_BEAT" || true
        beat_age=$(( ($(date +%s) - ${beat_at:-0}) / 86400 ))
        if (( beat_age >= 14 )); then
            warn "  آخرین استقرارِ موفق: $beat_ref — $beat_age روز پیش (کهنه)"
        else
            info "  آخرین استقرارِ موفق: $beat_ref — $beat_age روز پیش"
        fi
    else
        warn "  آخرین استقرارِ موفق: هرگز ثبت نشده"
        info "    (یا این نشانه تازه اضافه شده، یا هیچ استقراری تا آخر سبز نشده)"
    fi

    step "سلامتِ سایت"
    health_check || true

    if [[ -d "$STAGING_DIR/.git" && "$HESAB_ROLE" != "staging" ]]; then
        step "نسخه‌ی آزمایشی (staging)"
        if [[ -e "$STAGING_PAUSE" ]]; then
            warn "  کنار گذاشته شده (--pause): استقرار مستقیم روی سایتِ اصلی می‌رود."
            info "  برگشت:  sudo ./hesabland staging --resume"
        fi
        local sb sat sc
        sb="$(read_beat "$STAGING_DIR" || true)"
        if [[ -n "$sb" ]]; then
            read -r sat sc <<< "$sb"
            info "  آخرین نسخه‌ی سبزِ staging: $sc — $(( ($(date +%s) - ${sat:-0}) / 60 )) دقیقه پیش"
            if [[ "$sc" == "$(git rev-parse --short HEAD)" ]]; then
                info "  سایتِ اصلی همان نسخه است."
            else
                info "  سایتِ اصلی: $(git rev-parse --short HEAD) — برای انتشارِ نسخه‌ی staging:  sudo ./hesabland release"
            fi
        else
            warn "  staging ساخته شده ولی هنوز هیچ استقرارِ سبزی ندارد."
        fi
    fi

    step "migration"
    [[ -x deploy/migrate.sh ]] && bash deploy/migrate.sh 2>&1 | sed 's/^/  /' || true

    step "کارهای زمان‌بندی‌شده (cron)"
    # ⚠ status() یک **فهرست** برمی‌گرداند نه نگاشتِ کلیددار، پس نامِ کار
    #   از خودِ ردیف (`key`) خوانده می‌شود. و `functions.php` لازم است
    #   چون `ago()` از `toPersianDigits()` رد می‌شود — بدونش خطای کشنده
    #   می‌داد و کلِ کارت **بی‌صدا** خالی می‌ماند.
    php -r '
        require_once "includes/db.php";
        require_once "includes/functions.php";
        require_once "includes/cron_health.php";
        foreach (CronHealth::status() as $s) {
            $mark = $s["state"] === "ok" ? "+" : ($s["state"] === "stale" ? "!" : "-");
            printf("  %s %-11s %-28s %s\n", $mark, $s["key"], $s["label"] ?? "",
                   $s["state"] === "never" ? "هرگز اجرا نشده" : CronHealth::ago($s["age"] ?? null));
        }
    ' 2>/dev/null || warn "  ⚠ خوانده نشد."

    step "بکاپ‌ها"
    ls -lh /opt/hesab/backups/*.sql.gz 2>/dev/null | tail -5 \
        | awk '{print "  "$9"  "$5"  "$6" "$7" "$8}' || info "  هیچ بکاپی نیست."

    step "خطاها"
    php -r '
        require_once "includes/db.php"; require_once "includes/app_errors.php";
        printf("  %d خطا در ۷ روز گذشته\n", AppErrors::countSince(7));
    ' 2>/dev/null || warn "  ⚠ خوانده نشد."

    step "دیسک و سرویس"
    # ⛔ عددِ خام تصمیمی نمی‌سازد. دیسکِ پر، هم بکاپ را می‌کشد (فایلِ
    #    نصفه) هم دیتابیس را — و هر دو بی‌صدا. پس آستانه همین‌جا سنجیده
    #    می‌شود، نه اینکه به چشمِ آدم سپرده شود.
    local disk_pct disk_line
    disk_line="$(df -h "$APP_DIR" 2>/dev/null | tail -1 || true)"
    disk_pct="$(printf '%s' "$disk_line" | awk '{gsub("%","",$5); print $5+0}')"
    info "  دیسک: $(printf '%s' "$disk_line" | awk '{print $5" پر ("$3" از "$2")"}')"
    if (( ${disk_pct:-0} >= 90 )); then
        red "  ⛔ دیسک بالای ۹۰٪ — بکاپِ امشب ممکن است نصفه بماند."
        red "     ببینید:  sudo du -xh /opt/hesab /var/log --max-depth=2 | sort -h | tail -20"
    elif (( ${disk_pct:-0} >= 80 )); then
        warn "  ⚠ دیسک بالای ۸۰٪ — پیش از رسیدن به ۹۰٪ فکری بکنید."
        info "     بکاپ‌های قدیمی:  ls -lh /opt/hesab/backups | tail"
    fi
    local pool svc
    pool="$(declare -F fpm_pool_file >/dev/null && fpm_pool_file "$POOL_NAME" || true)"
    if [[ -n "$pool" ]]; then
        svc="php$(fpm_version_of "$pool")-fpm"
        systemctl is-active --quiet "$svc" 2>/dev/null && info "  $svc: فعال" || warn "  $svc: فعال نیست"
    else
        warn "  pool این اپ پیدا نشد (pool.d/${POOL_NAME}.conf)"
    fi
    systemctl is-active --quiet nginx 2>/dev/null && info "  nginx: فعال" || warn "  nginx: فعال نیست"
    echo
}

# ---------------------------------------------------------------------
cmd_rollback() {
    local target=''
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to) target="${2:-}"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [[ -z "$target" ]]; then
        # ⛔ نسخه‌ای که **واقعاً** پیش از آخرین استقرار روی سرور بود، نه
        #    HEAD~1 (توضیحِ DEPLOY_PREV بالای فایل). اگر ثبت نشده، حدس
        #    نمی‌زنیم: برگشت به کدی که هیچ‌وقت مستقر نبوده خودش یک خرابی است.
        target="$(head -1 "$DEPLOY_PREV" 2>/dev/null | tr -cd '0-9a-f' || true)"
        if [[ -z "$target" ]] || ! git cat-file -e "${target}^{commit}" 2>/dev/null; then
            red "نسخه‌ی قبلیِ مستقرشده ثبت نشده ($DEPLOY_PREV)."
            info "کامیتِ مقصد را صریح بدهید:  sudo ./hesabland rollback --to abc1234"
            git log --oneline -8 2>/dev/null | sed 's/^/  /'
            return 1
        fi
        if [[ "$(git rev-parse HEAD)" == "$(git rev-parse "$target")" ]]; then
            red "سایت همین حالا روی نسخه‌ی ثبت‌شده‌ی قبلی ($(git rev-parse --short "$target")) است."
            info "برای کامیتِ دیگر:  sudo ./hesabland rollback --to abc1234"
            return 1
        fi
        target="$(git rev-parse --short "$target")"
    fi

    warn "برگشت از $(git rev-parse --short HEAD) به $target"
    warn "⛔ این فقط **کد** را برمی‌گرداند. اگر بعد از آن کامیت migration"
    warn "   اعمال شده باشد، ساختارِ دیتابیس جلوتر می‌ماند و کدِ قدیمی"
    warn "   ممکن است با آن کار نکند. بازیابیِ دیتابیس کارِ جداست:"
    warn "   sudo bash deploy/restore.sh --admin"
    read -r -p "ادامه؟ (y/N) " a
    [[ "${a,,}" == "y" ]] || { info "لغو شد."; return 1; }

    record_prev "$target"
    git reset --hard "$target" --quiet
    apply_permissions
    clear_php_cache || true
    step "سنجشِ سلامت پس از برگشت"
    health_check || red "⛔ بعد از برگشت هم سالم نشد."
}

# ثبتِ کامیتِ فعلی پیش از فرود، **فقط** وقتی کد واقعاً عوض می‌شود: استقرارِ
# بی‌تغییر نباید «قبلی» را با «فعلی» بازنویسی کند، وگرنه rollback جایی
# برای رفتن نداشت.
record_prev() {
    local to="$1" cur
    cur="$(git rev-parse HEAD 2>/dev/null || true)"
    [[ -n "$cur" && "$cur" != "$(git rev-parse "$to" 2>/dev/null || true)" ]] || return 0
    mkdir -p "$(dirname "$DEPLOY_PREV")" 2>/dev/null || true
    printf '%s\n' "$cur" > "$DEPLOY_PREV" 2>/dev/null || true
}

# ---------------------------------------------------------------------
apply_permissions() {
    mkdir -p uploads/avatars var var/sessions var/cron var/log
    # (uploads/.htaccess دیگر نوشته نمی‌شود: پشتیبانیِ Apache برداشته شد و
    #  nginx آن فایل را نمی‌خواند. محافظتِ واقعیِ uploads/ در سایتِ nginx
    #  است — vps-setup.sh.)

    # نسخه‌ی مستقرشده، برای پروفایل و صفحه‌ی حریم خصوصی.
    # ⚠ اینجا نوشته می‌شود نه هنگام نمایش: pool این اپ exec/shell_exec را
    #   غیرفعال کرده (قانون جداسازی سرور)، پس PHP خودش git را نمی‌بیند.
    printf '%s · %s\n' "$(git rev-parse --short HEAD 2>/dev/null || echo '?')" \
                       "$(date '+%Y-%m-%d')" > var/version.txt 2>/dev/null || true

    # کد مالِ root می‌ماند تا نه PHP بتواند عوضش کند نه git خطای
    # «مالکیتِ مشکوک» بدهد. فقط uploads و var مالِ کاربرِ اپ‌اند.
    chown -R root:root . 2>/dev/null || true
    # ⛔ var/ و config/ از chmodِ سراسری بیرون‌اند. پیش از این هر استقرار
    #    همه‌چیز را ۶۴۴/۷۵۵ می‌کرد: کلیدِ خصوصیِ VAPID (var/push/vapid.json،
    #    0600)، فایل‌های ورودِ فروشگاه (var/biz-import، 0700/0600) و
    #    بکاپ‌های رمزدارِ config.php.bak* برای **هر کاربرِ دیگرِ این سرور**
    #    خواندنی می‌شدند — و config.php هم تا خطِ ۶۴۰ِ پایین چند لحظه ۶۴۴
    #    بود. دسترسیِ هر دو پوشه پایین‌تر صریح تنظیم می‌شود.
    find . \( -path ./.git -o -path ./var -o -path ./config \) -prune \
         -o -type d -exec chmod 755 {} +
    find . \( -path ./.git -o -path ./var -o -path ./config \) -prune \
         -o -type f -exec chmod 644 {} +
    chmod 755 config 2>/dev/null || true
    chmod 644 config/config.example.php 2>/dev/null || true
    chmod 600 config/config.php.bak* config/*.bak 2>/dev/null || true
    # گیت بیتِ اجرا را ردیابی می‌کند؛ بدونِ این خط git pull بعدی می‌شکند.
    find . -name '*.sh' -not -path './.git/*' -exec chmod 755 {} \;
    chmod 755 hesabland deploy.sh 2>/dev/null || true

    if id -u "$APP_USER" >/dev/null 2>&1; then
        chown -R "$APP_USER":"$APP_USER" uploads

        # ⚠️ var هم مثل uploads باید به کاربرِ اپ برگردد.
        #
        # این خط یک بار جا افتاده بود و باگی ساخت که هیچ ردی در لاگ
        # نداشت: session.save_path این pool داخلِ خودِ پوشه‌ی اپ است
        # (var/sessions)، پس chown -R root:root بالاتر آن را هم مالِ root
        # می‌کرد و PHP — که با کاربرِ اپ اجرا می‌شود — دیگر نمی‌توانست
        # فایلِ نشست بنویسد. نتیجه: هر درخواست یک نشستِ خالیِ تازه، پس
        # توکنِ CSRF هرگز نمی‌ماند و صفحه‌ی ورود در حلقه‌ی «نشست شما
        # منقضی شده بود» گیر می‌کرد. هیچ‌کس نمی‌توانست وارد شود.
        chown -R "$APP_USER":"$APP_USER" var
        chmod 700 var/sessions

        # ⛔ رازهای var/ به همان دسترسی‌ای برمی‌گردند که خودِ اپ ساخته بود
        #    (includes/push.php و biz_migrate.php: پوشه ۷۰۰، فایل ۶۰۰). روی
        #    نصبِ موجود، chmodِ سراسریِ استقرارهای قبلی آن‌ها را ۶۴۴ کرده بود
        #    و فقط بیرون گذاشتنِ var/ از آن chmod، چیزی را درست نمی‌کرد.
        local d
        for d in var/push var/biz-import; do
            [[ -d "$d" ]] || continue
            find "$d" -type d -exec chmod 700 {} +
            find "$d" -type f -exec chmod 600 {} +
        done

        # و واقعاً آزموده می‌شود. سکوت اینجا بدترین حالت است، چون اپ
        # بالا می‌آید و فقط هیچ‌کس نمی‌تواند وارد شود.
        if ! sudo -u "$APP_USER" test -w var/sessions 2>/dev/null; then
            red "⛔ کاربر $APP_USER نمی‌تواند در var/sessions بنویسد."
            red "   با این وضع هیچ‌کس نمی‌تواند وارد شود («نشست شما منقضی شده بود»)."
            red "   بررسی کنید:  ls -ld $APP_DIR/var $APP_DIR/var/sessions"
        fi
    else
        red "کاربر $APP_USER وجود ندارد — اول deploy/vps-setup.sh را اجرا کنید."
    fi

    # ⚠️ ترتیب مهم است: اول گروه به کاربرِ اپ، بعد 640. اگر chown شکست
    # بخورد و 640 اجرا شود، فایل مالِ root:root می‌ماند و PHP دیگر
    # نمی‌تواند بخواند — کلِ سایت ۵۰۰ می‌دهد. یک بار deploy/mail-setup.sh
    # همین کار را کرد و اپ خوابید. پس آخرش واقعاً می‌آزماییم.
    if [[ -f config/config.php ]]; then
        if chown root:"$APP_USER" config/config.php 2>/dev/null \
           && chmod 640 config/config.php 2>/dev/null \
           && sudo -u "$APP_USER" test -r config/config.php 2>/dev/null; then
            :
        else
            chmod 644 config/config.php 2>/dev/null || true
            red "config.php نتوانست 640 بماند — 644 شد تا اپ بالا بماند."
        fi
    fi
}

# ---------------------------------------------------------------------
# ⛔ نحوِ کدِ ورودی **پیش از فرود** سنجیده می‌شود.
#
# اگر بعد از `git reset --hard` بسنجیم، دیر است: opcache همان لحظه کدِ
# تازه را می‌بیند و سایت پیش از اولین سنجش خوابیده. اینجا فایل‌ها را از
# خودِ گیت می‌خوانیم، پس هیچ چیزی روی دیسک نمی‌نشیند.
# ---------------------------------------------------------------------
preflight_syntax() {
    local ref="$1" bad=0 f
    local files
    files=$(git diff --diff-filter=ACMR --name-only HEAD "$ref" -- '*.php' 2>/dev/null || true)
    [[ -z "$files" ]] && { info "هیچ فایلِ PHP ای عوض نشده."; return 0; }

    local n=0
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        n=$((n + 1))
        if ! git show "${ref}:${f}" 2>/dev/null | php -l >/dev/null 2>&1; then
            red "  ⛔ خطای نحو: $f"
            git show "${ref}:${f}" 2>/dev/null | php -l 2>&1 | sed 's/^/     /' | head -3
            bad=$((bad + 1))
        fi
    done <<< "$files"

    if (( bad > 0 )); then
        red "⛔ $bad فایل خطای نحو دارد — هیچ چیزی روی سرور ننشست."
        return 1
    fi
    green "✓ نحوِ هر $n فایلِ PHP ورودی درست است"
    return 0
}

# ---------------------------------------------------------------------
# ⛔ preflight_syntax فایل‌های **گیت** را می‌سنجد — ولی تنها فایلی که با
#    دست ویرایش می‌شود و عمداً در گیت **نیست** همان `config/config.php`
#    است. یعنی دقیقاً همان فایلی که هیچ بررسی‌ای نداشت، و یک حرفِ اضافه
#    در آن کلِ سایت را خواباند.
#
#    نبودِ این بررسی فقط «یک خطای دیرتر» نبود: استقرار تا آخر رفت، سنجشِ
#    سلامت نتوانست اجرا شود (چون APP_URL خوانده نمی‌شد)، و ابزار **کد را
#    بی‌دلیل برگرداند** — یعنی خرابی‌ای که ربطی به کدِ تازه نداشت، به
#    حسابِ آن گذاشته شد.
preflight_config() {
    step "بررسیِ config.php (تنها فایلی که در گیت نیست)"

    if ! declare -F config_problem >/dev/null 2>&1; then
        info "  (config-lib.sh هنوز روی دیسک نیست — این بررسی از استقرارِ بعد فعال می‌شود)"
        return 0
    fi

    local why
    why="$(config_problem APP_URL)"
    if [[ -n "$why" ]]; then
        red "⛔ config/config.php سالم نیست:"
        printf '%s\n' "$why" | sed 's/^/     /'
        red "   استقرار متوقف شد — تا این درست نشود سایت بالا نمی‌آید و"
        red "   برگرداندنِ کد هم دردی دوا نمی‌کند (خرابی از کدِ تازه نیست)."
        return 1
    fi
    green "✓ config.php خوانده می‌شود"
    return 0
}

# ---------------------------------------------------------------------
# نسخه‌ی آزمایشی (staging) و انتشار
#
# ⛔ کلِ نکته یک جمله است: **چیزی که روی سایتِ اصلی می‌نشیند باید همان
#    کامیتی باشد که در staging دیده شد.** نه «آخرین کد»، نه «تقریباً همان».
#    `release` شناسه‌ی کامیت را از نشانه‌ی سبزِ staging می‌خواند و فقط
#    همان را منتشر می‌کند؛ کامیت‌های تازه‌تری که هنوز دیده نشده‌اند منتشر
#    **نمی‌شوند** و صریح گفته می‌شوند. پس «کد زدیم ولی دیده نشد» ممکن
#    نیست: یا دیده شده و منتشر می‌شود، یا دیده نشده و جلویش گرفته می‌شود.
# ---------------------------------------------------------------------

# مقدارِ یک ثابت از یک فایلِ کانفیگِ مشخص (نه `$CONFIG`ِ جاری).
conf_get() {
    php -r 'require $argv[1]; echo defined($argv[2]) ? (string)constant($argv[2]) : "";' \
        "$1" "$2" 2>/dev/null || true
}

url_host() { local u="${1#http://}"; u="${u#https://}"; printf '%s' "${u%%/*}"; }

# ⛔ نگهبانِ اصلی: staging هرگز روی سایتِ اصلی نمی‌نشیند. یک migrationِ
#    آزمایشی روی hesab_db، یا یک `chown` روی /opt/hesab/app، یعنی خواباندنِ
#    سایتِ واقعی — و همه‌ی این‌ها فقط با یک کانفیگِ کپی‌شده‌ی اشتباه.
#    خروجیِ خالی یعنی سالم؛ هر خطِ خروجی یک علتِ رد است.
staging_guard() {
    local prod_conf="$1" stg_conf="$2" prod_dir="$3" stg_dir="$4"
    local a b
    a="$(readlink -f "$prod_dir" 2>/dev/null || printf '%s' "$prod_dir")"
    b="$(readlink -f "$stg_dir" 2>/dev/null || printf '%s' "$stg_dir")"
    if [[ "$a" == "$b" ]]; then
        echo "پوشه‌ی staging همان پوشه‌ی سایتِ اصلی است ($b)."; return 1
    fi
    if [[ ! -d "$stg_dir/.git" ]]; then
        echo "staging هنوز ساخته نشده ($stg_dir). اول:"
        echo "  sudo bash deploy/vps-setup.sh --staging --domain staging.hesab.stland.ir --apply"
        return 1
    fi
    if [[ ! -r "$stg_conf" ]]; then
        echo "کانفیگِ staging نیست یا خوانده نمی‌شود: $stg_conf"; return 1
    fi
    if ! php -l "$stg_conf" >/dev/null 2>&1; then
        echo "کانفیگِ staging خطای نحوی دارد: $(php -l "$stg_conf" 2>&1 | head -1)"; return 1
    fi
    if [[ "$(conf_get "$stg_conf" APP_ENV)" != "staging" ]]; then
        echo "در کانفیگِ staging باید باشد:  define('APP_ENV', 'staging');"; return 1
    fi
    local pdb sdb ph sh
    pdb="$(conf_get "$prod_conf" DB_NAME)"; sdb="$(conf_get "$stg_conf" DB_NAME)"
    ph="$(url_host "$(conf_get "$prod_conf" APP_URL)")"; sh="$(url_host "$(conf_get "$stg_conf" APP_URL)")"
    if [[ -z "$sdb" || "$sdb" == "$pdb" ]]; then
        echo "دیتابیسِ staging («${sdb:-خالی}») باید با دیتابیسِ سایتِ اصلی فرق کند."; return 1
    fi
    if [[ -z "$sh" || "$sh" == "$ph" ]]; then
        echo "آدرسِ staging («${sh:-خالی}») باید با آدرسِ سایتِ اصلی فرق کند."; return 1
    fi
    return 0
}

# ایمیل، پیامک یا اتصالِ فروشگاه در staging روشن است؟ هر خط یک مورد.
staging_outbound() {
    local c="$1" m
    m="$(conf_get "$c" MAIL_METHOD)"; [[ -n "$m" ]] && echo "ایمیل روشن است (MAIL_METHOD=$m)"
    m="$(conf_get "$c" SMS_METHOD)";  [[ -n "$m" && "$m" != "log" ]] && echo "پیامک روشن است (SMS_METHOD=$m)"
    m="$(conf_get "$c" STORE_API_URL)"; [[ -n "$m" ]] && echo "اتصال به حسابداریِ فروشگاه روشن است (STORE_API_URL)"
    return 0
}

# «اولین کامیت + زمان» از نشانه‌ی آخرین استقرارِ **سبز**.
read_beat() { local f="$1/var/deploy-ok.beat"; [[ -r "$f" ]] && head -1 "$f"; }

cmd_staging() {
    local branch='' clone=0 pass=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --branch)    branch="${2:-}"; shift 2 ;;
            --clone-db)  clone=1; shift ;;
            --password)  pass=1; shift ;;
            --pause)
                mkdir -p "$(dirname "$STAGING_PAUSE")" 2>/dev/null || true
                date +%s > "$STAGING_PAUSE"
                green "✓ staging کنار گذاشته شد — از این به بعد  sudo ./hesabland  مستقیم روی سایتِ اصلی می‌رود."
                info "  staging (پوشه، دیتابیس، رمز) سرِ جایش است. برگشت:  sudo ./hesabland staging --resume"
                return 0 ;;
            --resume)
                rm -f "$STAGING_PAUSE"
                green "✓ staging دوباره فعال است: اول  sudo ./hesabland staging  و بعد  sudo ./hesabland release"
                return 0 ;;
            *) red "گزینه‌ی ناشناخته برای staging: $1"; return 1 ;;
        esac
    done

    local stg_conf="$STAGING_DIR/config/config.php" why
    bold "══ نسخه‌ی آزمایشی (staging) ══"
    if ! why="$(staging_guard "$PROD_DIR/config/config.php" "$stg_conf" "$PROD_DIR" "$STAGING_DIR")"; then
        red "⛔ $why"
        return 1
    fi
    local host; host="$(url_host "$(conf_get "$stg_conf" APP_URL)")"

    # ---------- رمزِ تازه ----------
    if (( pass )); then
        local hp="/etc/nginx/${STAGING_SITE}.htpasswd" pw
        # ⛔ رمز فقط حروفِ کوچک و رقم است و نامِ کاربری با «H»ِ بزرگ هم پذیرفته
        #    می‌شود: کادرِ ورودِ سافاری روی آیفون حرفِ اول را خودش بزرگ می‌کند، پس
        #    «hesab» به «Hesab» تبدیل می‌شد و رمزِ درست هم رد می‌شد (اولین ورودِ
        #    واقعی همین بود). حروفِ شبیه‌به‌هم (l، o، 0، 1) هم عمداً نیستند.
        pw="$(head -c 64 /dev/urandom | tr -dc 'a-km-np-z2-9' | head -c 10)"
        cp -p "$hp" "$hp.bak" 2>/dev/null || true
        local h; h="$(openssl passwd -apr1 "$pw")"
        printf 'hesab:%s\nHesab:%s\n' "$h" "$h" > "$hp"
        chown root:www-data "$hp" 2>/dev/null || true; chmod 640 "$hp"
        if nginx -t >/dev/null 2>&1 && systemctl reload nginx; then
            green "✓ رمزِ تازه‌ی staging — نام: hesab   رمز: $pw"
            return 0
        fi
        [[ -f "$hp.bak" ]] && mv "$hp.bak" "$hp"
        red "⛔ nginx -t رد شد؛ رمزِ قبلی برگشت."
        return 1
    fi

    # ---------- گواهی ----------
    local site="/etc/nginx/sites-available/${STAGING_SITE}"
    if [[ -r "$site" ]] && ! grep -q ssl_certificate "$site"; then
        red "⛔ staging هنوز گواهی ندارد. اول رکوردِ DNS و بعد:"
        red "   sudo certbot --nginx -d $host"
        return 1
    fi

    # ---------- ایمیل و پیامک ----------
    local out; out="$(staging_outbound "$stg_conf")"
    if [[ -n "$out" ]]; then
        warn "⚠ در کانفیگِ staging:"
        printf '%s\n' "$out" | sed 's/^/     /'
        warn "  نسخه‌ی آزمایشی نباید به کسی پیام بفرستد — در $stg_conf خاموششان کنید."
    fi

    # ---------- کپیِ دیتابیس ----------
    if (( clone )); then
        # ⛔ با داده‌ی واقعی، ایمیل یا پیامکِ روشن یعنی staging به کاربرانِ
        #    واقعی پیام می‌فرستد (بازیابیِ رمز، یادآوری) — پس اینجا اخطار
        #    کافی نیست، جلویش گرفته می‌شود.
        if [[ -n "$out" ]]; then
            red "⛔ کپیِ دیتابیسِ واقعی با ایمیل/پیامکِ روشن انجام نمی‌شود."
            return 1
        fi
        # ⚠ بکاپِ ایمنیِ restore.sh (`*_before-restore_*`) عکسِ وضعیتِ کنارگذاشته است، نه آخرین بکاپ.
        local bk; bk="$(ls -1t /opt/hesab/backups/*.sql.gz 2>/dev/null | grep -v -- '_before-restore_' | head -1 || true)"
        [[ -n "$bk" ]] || { red "⛔ هیچ بکاپی نیست. اول:  sudo ./hesabland backup"; return 1; }
        step "پر کردنِ دیتابیسِ staging با $(basename "$bk")"
        warn "  ⚠ داده‌ی واقعیِ کاربران در staging می‌نشیند (پشتِ رمز، بی‌ایمیل و بی‌پیامک)."
        APP_DIR="$PROD_DIR" STAGING_DIR="$STAGING_DIR" bash "$PROD_DIR/deploy/restore.sh" --admin \
            --into "$(conf_get "$stg_conf" DB_NAME)" "$bk" 2>&1 | sed 's/^/  /'
        [[ ${PIPESTATUS[0]} -eq 0 ]] || { red "⛔ کپیِ دیتابیس شکست خورد."; return 1; }
    fi

    # ---------- شاخه ----------
    [[ -n "$branch" ]] || branch="$(git -C "$PROD_DIR" rev-parse --abbrev-ref HEAD)"
    git -C "$STAGING_DIR" fetch --all --quiet
    if ! git -C "$STAGING_DIR" rev-parse --verify --quiet "origin/$branch" >/dev/null; then
        red "⛔ شاخه‌ی «$branch» روی گیت‌هاب پیدا نشد."
        return 1
    fi
    # ⚠ فقط اشاره‌گرِ شاخه جابه‌جا می‌شود، نه فایل‌ها: فرود را خودِ deploy
    #   انجام می‌دهد، **بعد از** سنجشِ نحو — همان ترتیبِ سایتِ اصلی.
    if [[ "$(git -C "$STAGING_DIR" rev-parse --abbrev-ref HEAD)" != "$branch" ]]; then
        git -C "$STAGING_DIR" checkout -q -B "$branch" HEAD
    fi
    git -C "$STAGING_DIR" branch -q --set-upstream-to="origin/$branch" "$branch" 2>/dev/null || true

    # ---------- همان استقرار، روی پوشه‌ی staging ----------
    # بکاپ لازم نیست (نسخه‌ی دورریختنی است) و migration همیشه اعمال
    # می‌شود — staging دقیقاً همان جایی است که migration باید اول آنجا
    # آزموده شود.
    if APP_DIR="$STAGING_DIR" APP_USER="$STAGING_USER" CONFIG="$stg_conf" HESAB_ROLE=staging \
         bash "$SELF" deploy --no-backup --migrate --force; then
        local c; c="$(git -C "$STAGING_DIR" rev-parse --short HEAD)"
        echo
        bold "نسخه‌ی $c روی staging است:  https://$host"
        info "  بالای هر صفحه نوشته «نسخه‌ی آزمایشی · $c» — همان را ببینید."
        info "  اگر درست بود:  sudo ./hesabland release"
        return 0
    fi
    return 1
}

cmd_release() {
    local yes=0
    for a in "$@"; do [[ "$a" == "--yes" ]] && yes=1; done
    if [[ "$HESAB_ROLE" == "staging" ]]; then red "release فقط روی سایتِ اصلی."; return 1; fi

    bold "══ انتشار روی سایتِ اصلی ══"
    local beat at seen
    beat="$(read_beat "$STAGING_DIR" || true)"
    if [[ -z "$beat" ]]; then
        red "⛔ staging هنوز هیچ استقرارِ سبزی ندارد. اول:  sudo ./hesabland staging"
        return 1
    fi
    read -r at seen <<< "$beat"
    local now; now="$(git -C "$STAGING_DIR" rev-parse --short HEAD 2>/dev/null || true)"
    if [[ "$now" != "$seen" ]]; then
        red "⛔ staging الان روی $now است ولی آخرین استقرارِ سبزش $seen بود —"
        red "   یعنی آخرین استقرارِ staging سالم تمام نشد. اول درستش کنید."
        return 1
    fi
    local sha; sha="$(git -C "$STAGING_DIR" rev-parse HEAD)"

    git fetch --all --quiet
    local BRANCH; BRANCH="$(git rev-parse --abbrev-ref HEAD)"
    if ! git cat-file -e "${sha}^{commit}" 2>/dev/null \
         || ! git merge-base --is-ancestor "$sha" "origin/${BRANCH}" 2>/dev/null; then
        red "⛔ نسخه‌ی staging ($seen) روی شاخه‌ی سایتِ اصلی («$BRANCH») نیست."
        red "   staging شاخه‌ی دیگری را نشان می‌دهد:  sudo ./hesabland staging"
        return 1
    fi

    local cur; cur="$(git rev-parse --short HEAD)"
    if [[ "$(git rev-parse HEAD)" == "$sha" ]]; then
        green "✓ سایتِ اصلی همین حالا همان نسخه‌ی staging است ($seen). کاری لازم نیست."
        return 0
    fi

    local age=$(( ($(date +%s) - ${at:-0}) / 60 ))
    info "نسخه‌ی دیده‌شده در staging: $seen  ($age دقیقه پیش سبز شد)"
    info "سایتِ اصلی الان:            $cur"
    info "آنچه منتشر می‌شود:"
    git log --oneline "HEAD..$sha" | sed 's/^/  /'
    local newer; newer="$(git rev-list --count "$sha..origin/${BRANCH}")"
    if (( newer > 0 )); then
        warn "⚠ $newer کامیتِ تازه‌تر روی گیت‌هاب هست که در staging دیده نشده — **منتشر نمی‌شوند**."
    fi

    local mig=()
    if [[ -n "$(git diff --name-only HEAD "$sha" -- 'migration_*.sql' 'schema.sql')" ]]; then
        mig=(--migrate)
        info "این نسخه migration دارد (در staging اعمال و آزموده شد) — اینجا هم اعمال می‌شود، بعد از بکاپ."
    fi

    if (( ! yes )); then
        read -r -p "این همان نسخه‌ای است که در staging دیدید و درست بود؟ منتشر شود؟ (y/N) " a
        [[ "${a,,}" == "y" ]] || { info "لغو شد. چیزی عوض نشد."; return 1; }
    fi

    if cmd_deploy "--to=$sha" ${mig[@]+"${mig[@]}"}; then
        green "سایتِ اصلی حالا دقیقاً همان نسخه‌ای است که در staging دیدید: $seen"
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------
cmd_deploy() {
    local do_migrate=0 do_backup=1 do_health=1 force=0 to=''
    for a in "$@"; do
        case "$a" in
            --to=*)       to="${a#--to=}" ;;
            --migrate)    do_migrate=1 ;;
            --no-backup)  do_backup=0 ;;
            --no-health)  do_health=0 ;;
            --force)      force=1 ;;
            deploy)       ;;
            *) red "گزینه‌ی ناشناخته: $a"; usage; exit 1 ;;
        esac
    done

    if [[ "$HESAB_ROLE" == "staging" ]]; then
        bold "══ استقرار روی نسخه‌ی آزمایشی ($APP_DIR) ══"
    else
        bold "══ استقرارِ حساب لند ══"
    fi

    # ---------- تغییراتِ محلیِ سرور ----------
    if ! git diff --quiet || ! git diff --cached --quiet; then
        red "روی سرور تغییراتِ ذخیره‌نشده وجود دارد:"
        git status --short | sed 's/^/  /'
        if (( force )); then
            warn "--force داده شد؛ دور ریخته می‌شوند."
        else
            read -r -p "این تغییرات دور ریخته شوند؟ (y/N) " answer
            [[ "${answer,,}" == "y" ]] || { red "لغو شد."; exit 1; }
        fi
        git reset --hard --quiet
    fi

    # ---------- دریافت ----------
    step "دریافت از گیت"
    local BEFORE BRANCH AFTER
    BEFORE=$(git rev-parse --short HEAD)
    git fetch --all --quiet
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    local TARGET="${to:-origin/${BRANCH}}"

    if git diff --quiet HEAD "$TARGET" 2>/dev/null; then
        info "تغییری نبود (نسخه $BEFORE)."
    else
        info "تغییراتِ ورودی:"
        git log --oneline "HEAD..$TARGET" | sed 's/^/  /'
    fi

    # ⛔ وقتی staging هست، استقرارِ مستقیمِ چیزی که آنجا دیده نشده یک
    #    تصمیمِ صریح است، نه پیش‌فرض. `release` همان دیده‌شده را می‌برد.
    if [[ "$HESAB_ROLE" != "staging" && -z "$to" && $force -eq 0 && -d "$STAGING_DIR/.git" && ! -e "$STAGING_PAUSE" ]]; then
        local __seen
        __seen="$(read_beat "$STAGING_DIR" | awk '{print $2}' || true)"
        if [[ "$(git rev-parse --short "$TARGET")" != "${__seen:-}" ]] \
           && ! git diff --quiet HEAD "$TARGET" 2>/dev/null; then
            warn "⚠ این نسخه ($(git rev-parse --short "$TARGET")) در staging دیده نشده."
            warn "  برای انتشارِ همان چیزی که دیدید:  sudo ./hesabland release"
            read -r -p "با این حال مستقیم روی سایتِ اصلی برود؟ (y/N) " __a
            [[ "${__a,,}" == "y" ]] || { info "لغو شد. چیزی عوض نشد."; exit 1; }
        fi
    fi

    # ---------- نحو، پیش از فرود ----------
    step "بررسیِ نحوِ کدِ ورودی (پیش از نشستن روی دیسک)"
    preflight_syntax "$TARGET" || exit 1

    preflight_config || exit 1

    # ---------- بکاپ ----------
    if (( do_backup )); then
        step "بکاپِ دیتابیس پیش از استقرار"
        if [[ -x deploy/backup.sh ]] && bash deploy/backup.sh >/dev/null 2>&1; then
            green "✓ بکاپ گرفته شد"
        else
            # ⛔ بکاپِ نگرفته فقط وقتی مجازِ ادامه است که migration هم در
            #    کار نباشد: برگرداندنِ کد آسان است، برگرداندنِ ساختارِ
            #    دیتابیس نه.
            if (( do_migrate )); then
                red "⛔ بکاپ گرفته نشد و --migrate خواسته شده — جلو نمی‌رویم."
                red "   اول این را ببینید:  sudo bash deploy/backup.sh"
                exit 1
            fi
            warn "⚠ بکاپ گرفته نشد؛ چون migration هم اعمال نمی‌شود، ادامه می‌دهیم."
        fi
    fi

    # ---------- فرود ----------
    record_prev "$TARGET"
    git reset --hard "$TARGET" --quiet
    AFTER=$(git rev-parse --short HEAD)
    if [[ "$BEFORE" == "$AFTER" ]]; then
        info "نسخه همان $AFTER ماند."
    else
        green "به‌روزرسانی شد: $BEFORE → $AFTER"
    fi

    # ---------- دسترسی‌ها ----------
    step "دسترسی‌ها و پوشه‌ها"
    apply_permissions
    green "✓ انجام شد"

    # ---------- migration ----------
    local migrated=0
    step "migration"
    if [[ -x deploy/migrate.sh ]]; then
        if (( do_migrate )); then
            if bash deploy/migrate.sh --apply 2>&1 | sed 's/^/  /'; then
                migrated=1
            else
                red "⛔ اعمالِ migration شکست خورد."
                exit 1
            fi
        else
            bash deploy/migrate.sh 2>&1 | sed 's/^/  /' || true
            info "(اعمال نشد — با --migrate اعمال می‌شود. تغییرِ ساختارِ"
            info " دیتابیس باید تصمیمِ آگاهانه باشد، نه اثرِ جانبیِ deploy.)"
        fi
    fi

    # ---------- کش ----------
    step "پاک کردنِ کش"
    clear_php_cache || true
    info "نسخه‌ی دارایی‌ها: $(asset_version)"

    # ---------- سلامت ----------
    if (( do_health )); then
        step "سنجشِ سلامت"
        if health_check; then
            # ⛔ نشانه فقط اینجا زده می‌شود — بعد از سبز شدنِ سلامت، نه
            #    بعد از فرود آمدنِ کد. وگرنه استقراری که سایت را خوابانده
            #    هم «موفق» ثبت می‌شد، و این دقیقاً همان سنجشی است که روی
            #    خرابی سبز می‌شود.
            mkdir -p "$(dirname "$DEPLOY_BEAT")" 2>/dev/null || true
            printf '%s %s\n' "$(date +%s)" "$AFTER" > "$DEPLOY_BEAT" 2>/dev/null || true
            echo
            green "✅ استقرار کامل شد و سایت سالم است — $AFTER"
            return 0
        fi

        # ---------- برگشت ----------
        echo
        if (( migrated )); then
            red "⛔ سایت سالم نیست، ولی migration اعمال شده — **برنمی‌گردانیم**."
            red "   کدِ قدیمی روی ساختارِ تازه یک خرابیِ دیگر است، نه رفعِ خرابی."
            red "   دو راه:"
            red "     ۱. خطا را ببینید:   sudo ./hesabland logs"
            red "     ۲. بازیابیِ کامل:    sudo bash deploy/restore.sh --admin"
            exit 1
        fi

        if [[ "$BEFORE" == "$AFTER" ]]; then
            red "⛔ سایت سالم نیست، ولی این استقرار هیچ چیزی را عوض نکرد."
            red "   یعنی خرابی از قبل بوده. ببینید:  sudo ./hesabland logs"
            exit 1
        fi

        warn "برگشت خودکار به $BEFORE ..."
        git reset --hard "$BEFORE" --quiet
        apply_permissions
        clear_php_cache || true
        if health_check quiet; then
            green "✓ برگشت انجام شد و سایت دوباره سالم است (نسخه $BEFORE)."
            red "⛔ ولی کامیت $AFTER سایت را می‌خواباند — پیش از استقرارِ دوباره درستش کنید."
        else
            red "⛔ بعد از برگشت هم سالم نشد. خرابی جای دیگری است."
            red "   ببینید:  sudo ./hesabland logs   و   sudo ./hesabland status"
        fi
        exit 1
    fi

    echo
    warn "⚠ سنجشِ سلامت رد شد (--no-health) — یعنی هیچ چیزی تأیید نشده."
    green "استقرار انجام شد — $AFTER"
}

# ---------------------------------------------------------------------
# ⚠ اگر این فایل `source` شود فقط توابعش تعریف می‌شوند و هیچ کاری انجام
#   نمی‌دهد. دلیلش انعطاف نیست: بدونِ آن، تنها راهِ آزمودنِ
#   `preflight_syntax` و `health_check` کپی کردنشان در یک هارنس بود —
#   یعنی آزمودنِ یک نسخه‌ی دوم، همان دامی که بخشِ CSV در
#   `test_tx_search` یک بار در آن افتاد.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

cd "$APP_DIR" || { red "پوشه $APP_DIR پیدا نشد."; exit 1; }

CMD="${1:-deploy}"
[[ $# -gt 0 ]] && shift || true

case "$CMD" in
    deploy)   cmd_deploy "$@" ;;
    health)   step "سنجشِ سلامت"; health_check ;;
    cache)    cmd_cache "$@" ;;
    status)   cmd_status ;;
    backup)   cmd_backup "$@" ;;
    rollback) cmd_rollback "$@" ;;
    logs)     cmd_logs ;;
    staging)  cmd_staging "$@" ;;
    release)  cmd_release "$@" ;;
    help|-h|--help) usage ;;
    --*)      cmd_deploy "$CMD" "$@" ;;
    *)        red "فرمانِ ناشناخته: $CMD"; echo; usage; exit 1 ;;
esac

#!/usr/bin/env bash
#
# hesabland — نامِ قدیمِ `hastico` (پروژه به «هستیکو» تغییرِ نام داد، مهر ۱۴۰۵)
#
# ⛔ حذف نشد، چون «sudo ./hesabland» در حافظه‌ی مالکِ نصب، در پیام‌های قدیمی و
#    شاید در cronها نوشته شده — همان قاعده‌ی `deploy.sh`. هیچ منطقی این‌جا
#    نیست: نسخه‌ی دوم یعنی اولین اصلاح فقط به یکی می‌رسد.
#
# ⚠ `bash` صریح، نه اجرای مستقیم: اولین استقرار بعد از تغییرِ نام با کدِ
#   **قدیمیِ** حافظه تمام می‌شود که فقط `hesabland` را ۷۵۵ می‌کند، پس
#   `hastico` یک بار ۶۴۴ می‌ماند. `bash hastico` بیتِ اجرا نمی‌خواهد.

set -euo pipefail

main() {
    local here
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    if [[ ! -f "$here/hastico" ]]; then
        printf '\033[0;31m%s\033[0m\n' "hastico پیدا نشد — اول یک بار git pull کنید."
        exit 1
    fi

    exec bash "$here/hastico" "$@"
}

main "$@"
